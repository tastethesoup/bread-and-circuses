{% macro pickCheck() %}
<svg class="log-pick__svg" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
  <path d="M2.5 8.8 L6.2 12.3 L13.5 3.9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
{% endmacro %}

{% macro pickRow(ref, picked) %}
{%- set team = ref | logTeam -%}
<div class="log-pick__row{% if picked %} log-pick__row--picked{% endif %}">
  <span class="log-pick__mark">{% if picked %}{{ pickCheck() }}{% endif %}</span>
  <span class="log-pick__name">{{ team.name }}</span>
</div>
{% endmacro %}

{% macro scoreStack(game) %}
{%- set home = game.home | logTeam -%}
{%- set away = game.away | logTeam -%}
<article class="log-game{% if game.callout %} log-game--callout{% endif %}">
  {% if game.callout %}
  <div class="log-game__ribbon">{{ game.callout }}{% if game.calloutMargin %}<span class="log-game__margin">{{ game.calloutMargin }}</span>{% endif %}</div>
  {% endif %}
  <div class="log-score log-score--win">
    <span class="log-score__name">{{ home.name }}</span>
    <span class="log-score__pts">{{ game.homeScore | logScore }}</span>
  </div>
  <div class="log-score log-score--loss">
    <span class="log-score__name">{{ away.name }}</span>
    <span class="log-score__pts">{{ game.awayScore | logScore }}</span>
  </div>
  {% if game.roast %}
  <p class="log-game__roast">{{ game.roast }}</p>
  {% endif %}
</article>
{% endmacro %}

{% macro rankingRow(entry, index) %}
{%- set team = entry.team | logTeam -%}
{%- set move = entry.move if entry.move else "-" -%}
{%- set tone = move | logMove -%}
<div class="log-rank">
  <span class="log-rank__n{% if index > 5 %} log-rank__n--lower{% endif %}">{{ index }}</span>
  <div class="log-rank__body">
    <div class="log-rank__head">
      <span class="log-rank__name">{{ team.name }}</span>
      {% if entry.record %}
      <span class="log-rank__record">{{ entry.record }}</span>
      {% endif %}
      <span class="log-rank__move log-rank__move--{{ tone }}">{{ move }}</span>
    </div>
    {% if entry.blurb %}
    <p class="log-rank__blurb">{{ entry.blurb }}</p>
    {% endif %}
  </div>
</div>
{% endmacro %}

{% macro blotterItem(item, index) %}
{%- set team = item.team | logTeam -%}
<article class="log-blotter">
  <span class="log-blotter__n">{{ index }}</span>
  <div class="log-blotter__body">
    <p class="log-blotter__team">{{ team.name }}</p>
    <p class="log-blotter__charge">{{ item.charge }}</p>
    {% if item.evidence %}
    <p class="log-blotter__evidence">{{ item.evidence }}</p>
    {% endif %}
  </div>
</article>
{% endmacro %}

{% macro slateCard(game) %}
{%- set home = game.home | logTeam -%}
{%- set away = game.away | logTeam -%}
{%- set pick = game.pick | logTeam if game.pick else none -%}
<article class="log-slate{% if game.gotw %} log-slate--gotw{% endif %}">
  {% if game.gotw %}
  <div class="log-slate__gotw">Game of the Week</div>
  {% endif %}
  <div class="log-pick">
    {{ pickRow(game.home, pick and pick.slug == home.slug) }}
    <div class="log-pick__rule"></div>
    {{ pickRow(game.away, pick and pick.slug == away.slug) }}
  </div>
  {% if not game.pick %}
  <p class="log-slate__nopick">No pick</p>
  {% endif %}
  {% if game.roast %}
  <p class="log-slate__roast">{{ game.roast }}</p>
  {% endif %}
</article>
{% endmacro %}
