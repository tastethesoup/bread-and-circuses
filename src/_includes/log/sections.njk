{% from "log/macros.njk" import scoreStack, rankingRow, blotterItem, slateCard %}
{% set computed = log.games | logRecord %}
{% set recordLabel = log.record or computed.label %}
{% set nextWeek = log.nextWeek or (log.week + 1) %}

{% if log.games %}
<section class="log-section" id="games">
  <h2 class="log-section__title">The games</h2>
  <div class="log-games">
    {% for game in log.games %}
      {{ scoreStack(game) }}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if log.rankings %}
<section class="log-section" id="rankings">
  <div class="log-section__heading">
    <h2 class="log-section__title">Power rankings</h2>
    <span class="log-section__aside">{{ log.rankingsKicker or ("After Week " + log.week) }}</span>
  </div>
  <div class="log-rankings">
    {% for entry in log.rankings %}
      {{ rankingRow(entry, loop.index) }}
    {% endfor %}
  </div>
  {% if log.rankingsNote %}
  <p class="log-section__note">{{ log.rankingsNote }}</p>
  {% endif %}
</section>
{% endif %}

{% if log.blotter %}
<section class="log-section" id="blotter">
  <h2 class="log-section__title">Crime blotter</h2>
  <div class="log-blotters">
    {% for item in log.blotter %}
      {{ blotterItem(item, loop.index) }}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if log.slate %}
<section class="log-section" id="next">
  <div class="log-section__heading">
    <h2 class="log-section__title">Week {{ nextWeek }}</h2>
    <span class="log-section__aside">Our picks · record {{ recordLabel }}</span>
  </div>
  <div class="log-slates">
    {% for game in log.slate %}
      {{ slateCard(game) }}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if log.gotw %}
{%- set home = log.gotw.home | logTeam -%}
{%- set away = log.gotw.away | logTeam -%}
{%- set pick = log.gotw.pick | logTeam if log.gotw.pick else none -%}
<section class="log-section log-gotw" id="gotw">
  <h2 class="log-section__title">Game of the Week</h2>
  <p class="log-gotw__title">{{ home.name }} <span class="log-gotw__vs">vs</span> {{ away.name }}</p>
  {% if pick %}
  <div class="log-gotw__pickline">
    <span class="log-gotw__abbr">{{ pick.abbr }}</span>
    <span class="log-gotw__banner">Our pick - {{ log.gotw.pickLabel or pick.name }}</span>
  </div>
  {% endif %}
  <div class="log-gotw__colophon">
    <span>LOG prediction record</span>
    <span class="log-gotw__record">{{ recordLabel }}</span>
  </div>
  <div class="log-gotw__links">
    <a href="/">All posts</a>
    <a href="/feed.xml">RSS</a>
  </div>
</section>
{% endif %}
