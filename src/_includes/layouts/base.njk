<!DOCTYPE html>
<html lang="{{ site.language }}"{% if log %} class="log-page"{% elif homePage %} class="home-page"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    {% if tags and ("posts" in tags) %}
    {% set shareTitle = title %}
    {% set shareDescription = description or site.description %}
    {% set shareUrl = page.url | siteUrl %}
    {% set shareImagePath = "" %}
    {% if ogImage %}
      {% set shareImagePath = ogImage %}
    {% elif log and log.ogImage %}
      {% set shareImagePath = log.ogImage %}
    {% elif log and log.week %}
      {% set shareImagePath = log.week | logOgPath %}
    {% endif %}
    <meta property="og:title" content="{{ shareTitle }}">
    <meta property="og:description" content="{{ shareDescription }}">
    <meta property="og:url" content="{{ shareUrl }}">
    <meta property="og:type" content="article">
    {% if shareImagePath %}
    <meta property="og:image" content="{{ shareImagePath | siteUrl }}">
    {% endif %}
    <meta name="twitter:card" content="{% if shareImagePath %}summary_large_image{% else %}summary{% endif %}">
    {% if shareImagePath %}
    <meta name="twitter:image" content="{{ shareImagePath | siteUrl }}">
    {% endif %}
    <meta name="twitter:title" content="{{ shareTitle }}">
    <meta name="twitter:description" content="{{ shareDescription }}">
    {% endif %}
    {% if log or homePage %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- if homePage %}
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
    {%- else %}
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
    {%- endif %}
    {% endif %}
    <link rel="stylesheet" href="/css/style.css">
    {%- if homePage %}
    <link rel="stylesheet" href="/css/home.css">{% endif %}
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  </head>
  <body{% if log %} class="log-page"{% elif homePage %} class="home-page"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>
    {%- if not homePage %}
    <header class="site-header">
      <p class="site-title"><a href="/">{{ site.title }}</a></p>
      <p class="site-tagline">{{ site.description }}</p>
    </header>
    {%- endif %}
    <main id="main">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>{{ site.title }}</p>
      <p><a href="/archive/">All posts</a> · <a href="/feed.xml">RSS</a></p>
    </footer>
  </body>
</html>
